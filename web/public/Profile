<!DOCTYPE html>
<html lang="fr">
<head>
 <meta charset="UTF-8">
 <meta name="viewport" content="width=device-width, initial-scale=1.0">
 <title>Profil — Krosmoz Card</title>
 <meta name="theme-color" content="#c9a84c">
 <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>👤</text></svg>">
 <link rel="stylesheet" href="/css/style.css">
</head>
<body>

 <!-- NAVBAR -->
 <nav class="navbar scrolled">
  <div class="navbar-inner">
   <a href="/" class="navbar-brand">
    <span>🎴</span> KROSMOZ CARD
   </a>
   <ul class="navbar-links" id="navLinks">
    <li><a href="/">Accueil</a></li>
    <li><a href="/leaderboard">Classement</a></li>
   </ul>
   <button class="nav-toggle" id="navToggle" aria-label="Menu">☰</button>
  </div>
 </nav>

 <div class="page">
  <div class="container">
   <div id="profileContent">
    <div class="loading">
     <div class="spinner"></div>
     <p>Chargement du profil…</p>
    </div>
   </div>

   <footer class="footer">
    <p>🎴 <a href="/">Krosmoz Card</a> — krosmozcard.fr</p>
   </footer>
  </div>
 </div>

 <script>
 /* -------- Mobile nav -------- */
 document.getElementById("navToggle").addEventListener("click", () => {
  document.getElementById("navLinks").classList.toggle("open")
 })

 /* -------- Helpers -------- */
 function escapeHTML(str) {
  const div = document.createElement("div")
  div.textContent = str
  return div.innerHTML
 }

 function formatNumber(n) {
  return (n || 0).toLocaleString("fr-FR")
 }

 function timeSince(ts) {
  if (!ts) return "—"
  const days = Math.floor((Date.now() - new Date(ts).getTime()) / 86400000)
  if (days < 1) return "Aujourd'hui"
  if (days === 1) return "Hier"
  if (days < 30) return `${days} jours`
  if (days < 365) return `${Math.floor(days / 30)} mois`
  return `${Math.floor(days / 365)} an(s)`
 }

 const RARITY_COLORS = {
  C: "#95a5a6", U: "#2ecc71", R: "#3498db", SR: "#9b59b6",
  HR: "#e74c3c", UR: "#f1c40f", S: "#ecf0f1", SSR: "#ffcc00"
 }

 const RARITY_EMOJI = {
  C: "⚪", U: "🟢", R: "🔵", SR: "🟣",
  HR: "🔴", UR: "🟡", S: "✨", SSR: "🌈"
 }

 /* -------- Get user ID from URL -------- */
 const pathParts = window.location.pathname.split("/")
 const userId = pathParts[pathParts.length - 1]

 /* -------- Load profile -------- */
 async function loadProfile() {
  const container = document.getElementById("profileContent")

  if (!userId || !/^\d{16,22}$/.test(userId)) {
   container.innerHTML = `
    <div class="loading">
     <p style="color: var(--rarity-HR)">❌ ID joueur invalide</p>
     <p style="margin-top:12px"><a href="/leaderboard">← Retour au classement</a></p>
    </div>`
   return
  }

  try {
   const res = await fetch(`/api/profile/${userId}`)

   if (!res.ok) {
    container.innerHTML = `
     <div class="loading">
      <p style="color: var(--rarity-HR)">❌ Joueur introuvable</p>
      <p style="margin-top:12px"><a href="/leaderboard">← Retour au classement</a></p>
     </div>`
    return
   }

   const p = await res.json()
   const name = escapeHTML(p.discord?.displayName || userId)
   const avatar = p.discord?.avatarURL || "https://cdn.discordapp.com/embed/avatars/0.png"

   document.title = `${p.discord?.displayName || "Profil"} — Krosmoz Card`

   /* ---- Guild tag ---- */
   const guildTag = p.guild
    ? `<span class="profile-tag">${p.guild.emoji || "🏰"} <span class="tag-gold">${escapeHTML(p.guild.name)}</span> Niv.${p.guild.level}</span>`
    : `<span class="profile-tag">Pas de guilde</span>`

   /* ---- Set progress bars ---- */
   const setsHTML = (p.setProgress || []).map(set => {
    const pctClass = set.pct >= 100 ? "pct-100" : set.pct >= 70 ? "pct-70" : set.pct >= 50 ? "pct-50" : "pct-0"
    return `
     <div class="set-item">
      <div class="set-header">
       <span class="set-name">${escapeHTML(set.name)}</span>
       <span class="set-count">${set.owned}/${set.total} — ${set.pct}%</span>
      </div>
      <div class="set-bar">
       <div class="set-bar-fill ${pctClass}" style="width: ${set.pct}%"></div>
      </div>
     </div>`
   }).join("")

   /* ---- Rarity breakdown ---- */
   const rarities = ["C", "U", "R", "SR", "HR", "UR", "S", "SSR"]
   const rarityHTML = rarities.map(r => `
    <div class="rarity-item">
     <div class="rarity-label" style="color: ${RARITY_COLORS[r]}">${RARITY_EMOJI[r]} ${r}</div>
     <div class="rarity-count" style="color: ${RARITY_COLORS[r]}">${formatNumber(p.rarityBreakdown?.[r] || 0)}</div>
    </div>
   `).join("")

   /* ---- Render ---- */
   container.innerHTML = `
    <div style="margin-bottom:20px">
     <a href="/leaderboard" style="font-size:0.9rem; color:var(--text-muted)">← Retour au classement</a>
    </div>

    <!-- HEADER -->
    <div class="profile-header fade-in">
     <img src="${avatar}" alt="" class="profile-avatar" onerror="this.src='https://cdn.discordapp.com/embed/avatars/0.png'">
     <div class="profile-info">
      <h1>${name}</h1>
      <div class="profile-meta">
       <span class="profile-tag">⭐ Niveau <span class="tag-gold">${p.level}</span></span>
       <span class="profile-tag">🏅 ${escapeHTML(p.title)}</span>
       ${guildTag}
      </div>
      <div class="xp-bar-wrapper">
       <div class="xp-bar-label">
        <span>XP</span>
        <span>${p.level >= 200 ? "MAX" : `${formatNumber(p.xp)} / ${formatNumber(p.xpRequired)}`}</span>
       </div>
       <div class="xp-bar">
        <div class="xp-bar-fill" style="width: ${p.xpPercent}%"></div>
       </div>
      </div>
     </div>
    </div>

    <!-- STATS GRID -->
    <div class="profile-grid">

     <!-- Stats principales -->
     <div class="profile-card fade-in stagger-1">
      <h2>📊 Statistiques</h2>
      <div class="stat-row">
       <span class="stat-row-label">🎴 Cartes possédées</span>
       <span class="stat-row-value">${formatNumber(p.totalCards)}</span>
      </div>
      <div class="stat-row">
       <span class="stat-row-label">📚 Cartes uniques</span>
       <span class="stat-row-value">${formatNumber(p.uniqueCards)} / ${formatNumber(p.maxCards)}</span>
      </div>
      <div class="stat-row">
       <span class="stat-row-label">💰 Kamas</span>
       <span class="stat-row-value">${formatNumber(p.kamas)}</span>
      </div>
      <div class="stat-row">
       <span class="stat-row-label">🏆 Succès</span>
       <span class="stat-row-value">${formatNumber(p.achievements)}</span>
      </div>
      <div class="stat-row">
       <span class="stat-row-label">📦 Packs ouverts</span>
       <span class="stat-row-value">${formatNumber(p.stats.packsOpened)}</span>
      </div>
      <div class="stat-row">
       <span class="stat-row-label">⚗️ Fusions</span>
       <span class="stat-row-value">${formatNumber(p.stats.fusions)}</span>
      </div>
      <div class="stat-row">
       <span class="stat-row-label">🌈 SSR tirées</span>
       <span class="stat-row-value">${formatNumber(p.stats.ssrPulled)}</span>
      </div>
      <div class="stat-row">
       <span class="stat-row-label">✨ Shiny SSR</span>
       <span class="stat-row-value">${formatNumber(p.stats.shinySSR)}</span>
      </div>
     </div>

     <!-- Activité -->
     <div class="profile-card fade-in stagger-2">
      <h2>🎮 Activité</h2>
      <div class="stat-row">
       <span class="stat-row-label">🔥 Fusion critiques</span>
       <span class="stat-row-value">${formatNumber(p.stats.fusionCrit)}</span>
      </div>
      <div class="stat-row">
       <span class="stat-row-label">🎪 Event packs</span>
       <span class="stat-row-value">${formatNumber(p.stats.eventPacksOpened)}</span>
      </div>
      <div class="stat-row">
       <span class="stat-row-label">📅 Streak daily</span>
       <span class="stat-row-value">${formatNumber(p.stats.dailyStreak)} jours</span>
      </div>
      <div class="stat-row">
       <span class="stat-row-label">⚡ Streak activité</span>
       <span class="stat-row-value">${formatNumber(p.stats.activityStreak)} jours</span>
      </div>
      <div class="stat-row">
       <span class="stat-row-label">💳 Cartes vendues</span>
       <span class="stat-row-value">${formatNumber(p.stats.cardsSold)}</span>
      </div>
      <div class="stat-row">
       <span class="stat-row-label">🛒 Cartes achetées</span>
       <span class="stat-row-value">${formatNumber(p.stats.cardsBought)}</span>
      </div>
      <div class="stat-row">
       <span class="stat-row-label">🕐 Inscrit depuis</span>
       <span class="stat-row-value">${timeSince(p.stats.createdAt)}</span>
      </div>
      <div class="stat-row">
       <span class="stat-row-label">⭐ XP totale</span>
       <span class="stat-row-value">${formatNumber(p.totalXp)}</span>
      </div>
     </div>

    </div>

    <!-- Collection & Raretés -->
    <div class="profile-grid">

     <!-- Collection par set -->
     <div class="profile-card fade-in stagger-3">
      <h2>📚 Collection par set</h2>
      ${setsHTML || '<p style="color:var(--text-muted)">Aucun set disponible</p>'}
     </div>

     <!-- Répartition raretés -->
     <div class="profile-card fade-in stagger-4">
      <h2>🌈 Répartition par rareté</h2>
      <div class="rarity-grid">
       ${rarityHTML}
      </div>

      <div style="margin-top:24px">
       <h2 style="font-family:'Cinzel',serif; font-size:1.1rem; color:var(--gold-light); margin-bottom:12px">🏅 Titres débloqués</h2>
       <div style="display:flex; flex-wrap:wrap; gap:6px">
        ${(p.titles || []).map(t => `
         <span style="
          padding: 4px 12px;
          background: ${t === p.title ? 'var(--gold-subtle)' : 'var(--bg-elevated)'};
          border: 1px solid ${t === p.title ? 'var(--gold)' : 'rgba(255,255,255,0.04)'};
          border-radius: 100px;
          font-size: 0.85rem;
          color: ${t === p.title ? 'var(--gold)' : 'var(--text-muted)'};
         ">${escapeHTML(t)}</span>
        `).join("")}
       </div>
      </div>
     </div>

    </div>`

   /* Animate bars after render */
   requestAnimationFrame(() => {
    document.querySelectorAll(".set-bar-fill").forEach(el => {
     const w = el.style.width
     el.style.width = "0%"
     requestAnimationFrame(() => { el.style.width = w })
    })
    const xpFill = document.querySelector(".xp-bar-fill")
    if (xpFill) {
     const w = xpFill.style.width
     xpFill.style.width = "0%"
     requestAnimationFrame(() => { xpFill.style.width = w })
    }
   })

  } catch (err) {
   console.error("Profile error:", err)
   container.innerHTML = `
    <div class="loading">
     <p style="color: var(--rarity-HR)">Erreur de chargement</p>
     <p style="margin-top:12px"><a href="/leaderboard">← Retour au classement</a></p>
    </div>`
  }
 }

 loadProfile()
 </script>

</body>
</html>